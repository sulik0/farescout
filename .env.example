# Copy to .env. Never commit API keys or send them in chat.
# An OpenAI-compatible model endpoint (DeepSeek is an example).
FARESCOUT_MODEL=deepseek-chat
FARESCOUT_MODEL_BASE_URL=https://api.deepseek.com
FARESCOUT_MODEL_API_KEY=

# Optional second fare source. A missing key disables this source explicitly.
SERPAPI_API_KEY=
# Optional for FlyAI basic search; use the provider's official access rules.
FLYAI_API_KEY=

# Executables, not arbitrary command strings. Install per README.
SOCAI_BIN=socai
FLYAI_BIN=flyai
# Local-only reports/context; no credentials or browser profile exports.
FARESCOUT_DATA_DIR=./data
FARESCOUT_SOURCE_TIMEOUT=90
FARESCOUT_MAX_SECONDS=480
FARESCOUT_MAX_FARE_CALLS=10
# P1: bounded range/coarse/fine exploration. Final verification has its own budget.
FARESCOUT_MAX_DATE_CALLS=25
FARESCOUT_COARSE_DATES=3
FARESCOUT_FINE_DATES=1
FARESCOUT_SOCAI_NOTES=3
# Basic quality rules and provider-grounded Typical Price comparisons.
FARESCOUT_EVIDENCE_QUALITY=1
FARESCOUT_DEAL_STRENGTH=1

# Optional socai endpoint: only use a browser you have explicitly connected.
# SOCAI_CDP_URL=http://127.0.0.1:9222
# Optional public-community fallback via SerpAPI Google Search + Reddit public JSON.
FARESCOUT_WEB_FALLBACK=1
