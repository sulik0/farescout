+fn error_class(error: &async_tungstenite::tungstenite::Error) -> String {
+    use async_tungstenite::tungstenite::Error;
+    match error {
+        Error::Io(error) => format!("io_{:?}", error.kind()),
+        Error::Protocol(_) => "protocol".into(),
+        Error::ConnectionClosed => "connection_closed".into(),
+        Error::AlreadyClosed => "already_closed".into(),
+        Error::Tls(_) => "tls".into(),
+        _ => "other".into(),
+    }
+}
+
+fn terminal(connection_id: u64, connected_at: Instant, kind: &str, error_class: &str, close_code: Option<u16>, reason_bytes: usize, pending_commands: usize) {
+    // Emit at the transport boundary, even when no command is awaiting a reply.
+    // Omit raw errors, URLs and close reason text to protect tokens and page data.
+    tracing::warn!(target: "socai::cdp::raw", connection_id, pid = std::process::id(), kind, error_class,
+        close_code, reason_bytes, pending_commands, uptime_ms = connected_at.elapsed().as_millis() as u64,
+        "cdp_ws_terminal");
 }
 
